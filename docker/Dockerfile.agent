# Build agent for Jenkins (and any CI): JDK 17 + Maven + Playwright's Chromium with its OS packages.
# The browser is baked into the image, so builds do not download it every time and need no root or apt.
FROM maven:3.9-eclipse-temurin-17

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /tmp/warm
COPY pom.xml .

# Installs Chromium and its system libraries. Maven only needs the pom to resolve the Playwright CLI.
# Jenkins runs the container as a non-root user, so the browser folder must be readable by everyone.
RUN mvn -B -ntp -q exec:java \
        -Dexec.mainClass=com.microsoft.playwright.CLI \
        -Dexec.classpathScope=test \
        "-Dexec.args=install --with-deps chromium" \
    && chmod -R a+rwX /ms-playwright \
    && rm -rf /root/.m2 /tmp/warm /var/lib/apt/lists/*

WORKDIR /
